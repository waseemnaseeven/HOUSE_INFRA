---
# App1: worker1
apiVersion: v1
kind: ConfigMap
metadata:
  name: app1-html
  namespace: dev
data:
  index.html: |
    <html>
    <body><h1>Hello from app1</h1><body>
    </html>

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app1
  namespace: dev
spec:
  replicas: 1
  selector:
    matchLabels: { app: app1 }
  template:
    metadata:
      labels: { app: app1 }
    spec:
      nodeSelector: { node: worker1 }
      containers:
        - name: nginx
          image: nginx:stable
          ports: [{ containerPort: 80}]
          volumeMounts:
            - name: html
              mountPath: /usr/share/nginx/html/index.html
              subPath: index.html
      volumes:
        - name: html
          configMap:
            name: app1-html

---
apiVersion: v1
kind: Service
metadata:
  name: app1-svc
  namespace: dev
spec:
  type: NodePort
  selector: { app: app1 }
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30011


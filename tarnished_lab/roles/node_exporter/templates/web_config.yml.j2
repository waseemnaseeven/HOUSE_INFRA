{% if node_exporter_tls_server_enabled | default(false) %}
tls_server_config:
  cert_file: {{ node_exporter_crt_file }}
  key_file: {{ node_exporter_key_file }}
{% if node_exporter_tls_validate_client_enabled %}
  client_ca_file: {{ node_exporter_ca_file }}
  client_auth_type: RequireAndVerifyClientCert
  client_allowed_sans:
{% for client in node_exporter_tls_clients %}
    - "{{ client }}"
{% endfor %}
{% endif %}
{% endif %}
{% if node_exporter_basic_auth_users | length > 0 %}
basic_auth_users:
{% for user, hash in node_exporter_basic_auth_users.items() %}
  {{ user }}: {{ hash }}
{% endfor %}
{% endif %}
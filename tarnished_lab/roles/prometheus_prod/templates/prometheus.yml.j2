global:
  scrape_interval: 20s # Default is every 1 minute.
  evaluation_interval: 1m # Default is every 1 minute.
  external_labels:
    prometheus_replica: {{ prometheus_replica_name }}

# Alertmanager configuration
alerting:
  alert_relabel_configs:
    - action: labeldrop
      regex: prometheus_replica
  alertmanagers:
    - scheme: https
      tls_config: {{ prometheus_tls_config_client | to_yaml }}
      static_configs:
        - targets:
{% for alertmanager in prometheus_alertmanagers %}
          - {{ alertmanager }}:{{ prometheus_alertmanagers_port }}
{% endfor %}

rule_files:
{% for rule_file in prometheus_rules_enabled_files %}
  - rules/{{ rule_file }}
{% endfor %}

scrape_configs:
{% for job_name, job_options in prometheus_jobs.items() %}
  - job_name: "{{ job_name }}"
    scheme: https
    tls_config: {{ prometheus_tls_config_client | to_yaml }}
    static_configs:
      - targets:
{% for target in job_options.targets | default([]) %}
        - {{ target }}{% if job_options.port | default("") | length > 0 %}:{{ job_options.port }}{% endif %}

{% endfor %}
{% endfor %}

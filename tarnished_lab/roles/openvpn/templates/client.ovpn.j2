##############################################
# OpenVPN Client Configuration for {{ client_name }}
# Generated by Ansible
##############################################

client
dev tun
proto {{ openvpn_protocol }}

# Server address and port
remote {{ ansible_default_ipv4.address }} {{ openvpn_port }}

resolv-retry infinite
nobind

# Downgrade privileges after initialization (non-Windows only)
user nobody
group nogroup

# Keep keys and tunnel open across restarts
persist-key
persist-tun

# Verify server certificate
remote-cert-tls server

# Cryptography settings
cipher {{ openvpn_cipher }}
auth {{ openvpn_auth }}

# Compression
compress lz4-v2

# Logging
verb 3
mute 20

# TLS authentication direction
key-direction 1

<ca>
{{ ca_cert }}
</ca>

<cert>
{{ client_cert }}
</cert>

<key>
{{ client_key }}
</key>

<tls-auth>
{{ ta_key }}
</tls-auth>
